# --- Database (used by docker-compose AND by the harvester) ---
POSTGRES_USER=iris
POSTGRES_PASSWORD=change_me
POSTGRES_DB=iris
DATABASE_URL=postgresql://iris:change_me@localhost:5433/iris

# --- OParl sources, comma-separated System URLs ---
# Endpoints that answered on 2026-10-27 (re-check with scripts/check_endpoints.py).
# Politik bei uns (https://oparl.politik-bei-uns.de/system) is a nationwide aggregator:
# add it only if it lists Frankfurt / Hessian bodies.
OPARL_SYSTEM_URLS=https://kronberg.ratsinfomanagement.net/webservice/oparl/v1.1/system,https://rim.ekom21.de/schmitten/webservice/oparl/v1.1/system,https://rim.ekom21.de/glashuetten/webservice/oparl/v1.1/system

# Geographic filter: keep bodies whose AGS starts with one of these (06 = Hesse). Empty = no filter.
OPARL_BODY_AGS_PREFIXES=06

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
